# Copy to .env (gitignored, never commit this file)
# Keyless core works with no keys at all. Add a key only for LLM fields.

# Your key for LLM fields (seller names, skills, clauses). Any provider:
API_KEY=sk-...

# Model + endpoint. Defaults work for OpenAI; override for others:
# MODEL=gpt-6-luna
# BASE_URL=https://api.openai.com/v1
# Local: MODEL=qwen3:8b BASE_URL=http://localhost:11434/v1 API_KEY=dummy

# Optional escalation: big model for flagged fields the small one misses.
# Only fires on ungrounded misses; every call still metered in meta.cost.
# MODEL_BIG=gpt-4o
# Optional: append every LLM call to COSTS.jsonl
# QLERIC_COST_LOG=1
